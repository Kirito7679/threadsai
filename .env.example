# ---------- Threads App (developers.facebook.com -> Use cases -> Threads API) ----------
THREADS_APP_ID=
THREADS_APP_SECRET=
# Должен ТОЧНО совпадать с Redirect Callback URL в настройках приложения Threads
THREADS_REDIRECT_URI=https://your-app.up.railway.app/auth/callback

# ---------- Публичный адрес приложения ----------
APP_BASE_URL=https://your-app.up.railway.app

# ---------- Доступ в панель ----------
DASHBOARD_PASSWORD=change-me-please
# Любая длинная случайная строка. Используется для подписи cookie и шифрования токенов.
SECRET_KEY=generate-a-long-random-string

# ---------- База ----------
# На Railway подставится автоматически, если добавить плагин Postgres: ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite:///./data/app.db

# ---------- DeepSeek ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner
# Цены в долларах за миллион токенов — по ним считается стоимость аккаунта
# в разделе «Расход на модель». Сверяйте с актуальным тарифом DeepSeek.
DEEPSEEK_PRICE_INPUT=0.27
DEEPSEEK_PRICE_CACHED=0.07
DEEPSEEK_PRICE_OUTPUT=1.10

# ---------- Поведение ----------
TIMEZONE=Europe/Moscow
DRAFTS_PER_RUN=5
RESEARCH_INTERVAL_HOURS=6
METRICS_INTERVAL_MINUTES=60
GENERATION_HOUR=8
ENABLE_SCHEDULER=true
